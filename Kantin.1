<script>
// ===== Firebase ayarları =====
// Firebase Console > Project settings > Your apps > Web app'ten aldığın değerleri buraya yapıştır.
// Boş bırakırsan uygulama bulutsuz (sadece bu cihazda) çalışır.
const FIREBASE_CONFIG = {
  apiKey: "",
  authDomain: "",
  projectId: "",
  storageBucket: "",
  messagingSenderId: "",
  appId: ""
};

let fbAuth = null, fbDb = null, fbUser = null;
let cloudEnabled = false;
let lastSyncTime = 0;

// ===== Veri (localStorage) =====
const STORE_KEY = 'kantin_products';
const _origSetItem = localStorage.setItem.bind(localStorage);
const _origRemoveItem = localStorage.removeItem.bind(localStorage);

function cloudQueue(k, v) {
  if (!cloudEnabled || !fbUser || !fbDb) return;
  clearTimeout(cloudQueue._t && cloudQueue._t[k]);
  cloudQueue._t = cloudQueue._t || {};
  clearTimeout(cloudQueue._t[k]);
  cloudQueue._t[k] = setTimeout(async () => {
    try {
      await fbDb.collection('users').doc(fbUser.uid).set({ [k]: v }, { merge: true });
      lastSyncTime = Date.now();
      setSyncStatus('ok');
    } catch (e) {
      console.error('Bulut kayıt hatası', e);
      setSyncStatus('err');
    }
  }, 700);
}

localStorage.setItem = function (k, v) {
  _origSetItem(k, v);
  if (typeof k === 'string' && k.indexOf('kantin_') === 0) cloudQueue(k, v);
};
localStorage.removeItem = function (k) {
  _origRemoveItem(k);
  if (typeof k === 'string' && k.indexOf('kantin_') === 0 && cloudEnabled && fbUser && fbDb) {
    fbDb.collection('users').doc(fbUser.uid).set({ [k]: null }, { merge: true }).catch(() => {});
  }
};

let products = {};
try { products = JSON.parse(localStorage.getItem(STORE_KEY) || '{}') || {}; } catch (e) { products = {}; }
let cart = {};
let editingKey = null;
let activeCat = 'all';
let lastReceipt = null;

function saveProducts() {
  try { localStorage.setItem(STORE_KEY, JSON.stringify(products)); }
  catch (e) { showMsg('define', 'Kayıt yapılamadı: tarayıcı depolaması kapalı olabilir.', 'err', 6000); }
}

// ===== Ayarlar =====
let settings = loadJ('kantin_set', null) || { dark: false, lastBackup: Date.now(), salesSinceBk: 0, critTh: 3, priceMode: 'p1' };
function saveSet() { saveJ('kantin_set', settings); }
function toggleDark() { settings.dark = !settings.dark; saveSet(); applyDark(); }
function applyDark() { document.body.classList.toggle('dark', !!settings.dark); const b = document.getElementById('darkBtn'); if (b) b.textContent = settings.dark ? '☀️' : '🌙'; }
function setPriceMode(m) {
  settings.priceMode = m; saveSet();
  document.getElementById('modeP1').classList.toggle('active', m === 'p1');
  document.getElementById('modeP2').classList.toggle('active', m === 'p2');
  renderGrid(); renderCart(); updateChange();
}

// ===== Yardımcılar =====
function money(kurus) { return (kurus / 100).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺'; }
function toKurus(price) { return Math.round(Number(price) * 100); }
function parsePrice(text) { const n = parseFloat(String(text).trim().replace(/\s/g, '').replace(',', '.')); return isNaN(n) ? NaN : n; }
function hasStock(p) { return typeof p.stock === 'number' && !isNaN(p.stock); }
function parseStock(text) { const t = String(text).trim(); if (t === '') return null; const n = parseInt(t, 10); return (isNaN(n) || n < 0) ? NaN : n; }
function findKey(code) { if (products[code]) return code; const lower = code.toLowerCase(); return Object.keys(products).find(k => k.toLowerCase() === lower) || null; }
function newAutoCode() { let i = Object.keys(products).length + 1; while (products['URN-' + String(i).padStart(4, '0')]) i++; return 'URN-' + String(i).padStart(4, '0'); }
function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
function priceOf(k) { const p = products[k]; return (settings.priceMode === 'p2' && p.price2) ? p.price2 : p.price; }
function calcCartTotal() { return Object.keys(cart).filter(k => products[k]).reduce((s, k) => s + toKurus(priceOf(k)) * cart[k], 0); }

// ===== Ses =====
let AC = null;
function beep(f, d) {
  try {
    AC = AC || new (window.AudioContext || window.webkitAudioContext)();
    const o = AC.createOscillator(), g = AC.createGain();
    o.type = 'sine'; o.frequency.value = f || 880;
    g.gain.setValueAtTime(0.1, AC.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, AC.currentTime + (d || 0.08));
    o.connect(g); g.connect(AC.destination);
    o.start(); o.stop(AC.currentTime + (d || 0.08));
  } catch (e) {}
}

// ===== Modal =====
function openModal(html) { document.getElementById('modalBody').innerHTML = html; document.getElementById('modalWrap').classList.remove('hidden'); }
function closeModal() { document.getElementById('modalWrap').classList.add('hidden'); document.getElementById('modalBody').innerHTML = ''; }

// ===== Yazdırma =====
function printHTML(html) {
  const pa = document.getElementById('printArea');
  pa.innerHTML = html;
  document.body.classList.add('printing');
  setTimeout(() => { window.print(); setTimeout(() => document.body.classList.remove('printing'), 400); }, 60);
}

const msgTimers = {};
function showMsg(mode, text, type, duration) {
  const el = document.getElementById({ define: 'defineMsg', cart: 'cartMsg', cnt: 'countMsg', inm: 'inMsg', xl: 'xlMsg', tl: 'toolMsg', sm: 'sumMsg', wm: 'wmMsg' }[mode] || 'sellMsg');
  if (!el) return;
  el.className = 'msg ' + type;
  el.textContent = text;
  clearTimeout(msgTimers[mode]);
  msgTimers[mode] = setTimeout(() => { el.className = 'msg'; }, duration || 3500);
}

// ===== Sekmeler =====
function showTab(tab) {
  ['sell', 'define', 'list', 'count', 'summary', 'tools', 'msg'].forEach(t => {
    document.getElementById('panel-' + t).classList.toggle('hidden', t !== tab);
    document.getElementById('tab' + t.charAt(0).toUpperCase() + t.slice(1)).classList.toggle('active', t === tab);
  });
  if (tab === 'sell') { renderGrid(); renderRecent(); }
  if (tab === 'list') renderProductList();
  if (tab === 'count') renderCount();
  if (tab === 'summary') renderOverview();
  if (tab === 'tools') { renderTools(); renderAccount(); }
  if (tab === 'msg') openMsgTab();
  if (tab !== 'define' && editingKey) cancelEdit();
}

// ===== Satış =====
function addToCart(key) {
  cart[key] = (cart[key] || 0) + 1;
  beep(700, 0.05);
  renderCart();
  updateChange();
}
function addByCode() {
  const input = document.getElementById('codeInput');
  const code = input.value.trim();
  if (!code) return;
  const key = findKey(code);
  input.value = '';
  if (!key) { showMsg('sell', 'Bu kod tanımlı değil: ' + code, 'err'); return; }
  addToCart(key);
  showMsg('sell', '✅ ' + products[key].name + ' sepete eklendi.', 'ok', 1800);
  input.focus();
}
document.getElementById('codeInput').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); addByCode(); } });

function catsOf() {
  const s = [];
  Object.keys(products).forEach(k => { const c = products[k].cat; if (c && s.indexOf(c) < 0) s.push(c); });
  return s.sort((a, b) => a.localeCompare(b, 'tr'));
}
function renderCatChips() {
  const box = document.getElementById('catChips');
  box.innerHTML = '';
  const cats = catsOf();
  if (!cats.length) return;
  const mk = (label, val) => {
    const b = document.createElement('button');
    b.className = 'chip' + (activeCat === val ? ' active' : '');
    b.textContent = label;
    b.onclick = () => { activeCat = val; renderGrid(); };
    box.appendChild(b);
  };
  mk('Tümü', 'all');
  cats.forEach(c => mk(c, c));
}
function renderGrid() {
  renderCatChips();
  const grid = document.getElementById('productGrid');
  const q = document.getElementById('searchInput').value.trim().toLocaleLowerCase('tr-TR');
  grid.innerHTML = '';
  const keys = Object.keys(products)
    .filter(k => activeCat === 'all' || products[k].cat === activeCat)
    .filter(k => products[k].name.toLocaleLowerCase('tr-TR').includes(q))
    .sort((a, b) => products[a].name.localeCompare(products[b].name, 'tr'));
  if (keys.length === 0) {
    const p = document.createElement('p');
    p.className = 'empty';
    p.style.gridColumn = '1 / -1';
    p.textContent = Object.keys(products).length === 0 ? 'Henüz ürün yok. "Ekle" sekmesinden ilk ürünü tanımlayın.' : 'Aramaya uygun ürün bulunamadı.';
    grid.appendChild(p);
    return;
  }
  keys.forEach(k => {
    const b = document.createElement('button');
    b.className = 'prod';
    const n = document.createElement('b'); n.textContent = products[k].name;
    const f = document.createElement('span'); f.textContent = money(toKurus(priceOf(k)));
    b.appendChild(n); b.appendChild(f);
    if (hasStock(products[k])) {
      const st = document.createElement('span'); st.className = 'stock';
      st.textContent = 'Raf: ' + (products[k].stock > 0 ? products[k].stock : 'yok');
      b.appendChild(st);
      if (products[k].stock <= 0) b.classList.add('out');
    }
    if (products[k].depo > 0) { const dp = document.createElement('span'); dp.className = 'stock'; dp.textContent = 'Depo: ' + products[k].depo; b.appendChild(dp); }
    if (products[k].cat) { const ct = document.createElement('span'); ct.className = 'stock'; ct.textContent = products[k].cat; b.appendChild(ct); }
    b.onclick = () => addToCart(k);
    grid.appendChild(b);
  });
}
function renderRecent() {
  const box = document.getElementById('recentStrip');
  box.innerHTML = '';
  const seen = [];
  const sales = logs.filter(l => l.type === 'sale').slice(-40);
  for (let i = sales.length - 1; i >= 0 && seen.length < 8; i--) {
    const l = sales[i];
    if (products[l.key] && seen.indexOf(l.key) < 0) {
      seen.push(l.key);
      const b = document.createElement('button');
      b.className = 'chip';
      b.textContent = '↩ ' + l.name;
      b.onclick = () => addToCart(l.key);
      box.appendChild(b);
    }
  }
}
function renderCart() {
  const body = document.getElementById('cartBody');
  body.innerHTML = '';
  let total = 0;
  const keys = Object.keys(cart).filter(k => products[k]);
  Object.keys(cart).forEach(k => { if (!products[k]) delete cart[k]; });
  if (keys.length === 0) {
    const tr = document.createElement('tr');
    const td = document.createElement('td');
    td.colSpan = 3; td.className = 'empty'; td.textContent = 'Sepet boş.';
    tr.appendChild(td); body.appendChild(tr);
  }
  keys.forEach(k => {
    const p = products[k], qty = cart[k];
    const unit = priceOf(k);
    const line = toKurus(unit) * qty;
    total += line;
    const tr = document.createElement('tr');
    const nameTd = document.createElement('td'); nameTd.textContent = p.name;
    if (p.price2) { const m = document.createElement('span'); m.className = 'code'; m.textContent = money(toKurus(unit)); nameTd.appendChild(m); }
    if (hasStock(p) && qty > p.stock) {
      const w = document.createElement('span'); w.className = 'warn';
      w.textContent = 'Rafta ' + p.stock + ' adet görünüyor';
      nameTd.appendChild(w);
    }
    const qtyTd = document.createElement('td'); qtyTd.className = 'num';
    const wrap = document.createElement('div'); wrap.className = 'qty';
    const minus = document.createElement('button'); minus.textContent = '−'; minus.setAttribute('aria-label', p.name + ' azalt'); minus.onclick = () => changeQty(k, -1);
    const count = document.createElement('span'); count.textContent = qty;
    const plus = document.createElement('button'); plus.textContent = '+'; plus.setAttribute('aria-label', p.name + ' artır'); plus.onclick = () => changeQty(k, 1);
    const b5 = document.createElement('button'); b5.textContent = '+5'; b5.className = 'wide'; b5.setAttribute('aria-label', p.name + ' 5 artır'); b5.onclick = () => changeQty(k, 5);
    wrap.appendChild(minus); wrap.appendChild(count); wrap.appendChild(plus); wrap.appendChild(b5);
    qtyTd.appendChild(wrap);
    const sumTd = document.createElement('td'); sumTd.className = 'num'; sumTd.textContent = money(line);
    tr.appendChild(nameTd); tr.appendChild(qtyTd); tr.appendChild(sumTd);
    body.appendChild(tr);
  });
  document.getElementById('cartTotal').textContent = 'Toplam: ' + money(total);
}
function changeQty(key, delta) { cart[key] = (cart[key] || 0) + delta; if (cart[key] <= 0) delete cart[key]; renderCart(); updateChange(); }

function setPaid(v) {
  const t = calcCartTotal();
  document.getElementById('paidAmt').value = String(v === 'exact' ? (t / 100) : v);
  updateChange();
  beep(600, 0.05);
}
function updateChange() {
  const box = document.getElementById('changeBox');
  const raw = document.getElementById('paidAmt').value.trim();
  const t = calcCartTotal();
  if (!raw || t === 0) { box.textContent = ''; return; }
  const p = parsePrice(raw);
  if (isNaN(p)) { box.textContent = ''; return; }
  const ch = toKurus(p) - t;
  box.className = 'change-box ' + (ch < 0 ? 'bad' : 'ok');
  box.textContent = ch < 0 ? ('Eksik: ' + money(-ch)) : ('Para üstü: ' + money(ch));
}
function completeSale(onCredit) {
  const keys = Object.keys(cart).filter(k => products[k]);
  if (keys.length === 0) { showMsg('cart', 'Sepet boş.', 'err'); return; }
  const typed = document.getElementById('debtName').value.trim();
  const who = onCredit ? (customerKey(typed) || typed) : '';
  if (onCredit && !who) { showMsg('cart', 'Veresiye için kişi adını yazın.', 'err'); return; }
  const ck = customerKey(who || typed);
  if (onCredit && ck && customers[ck].limit > 0) {
    const after = bal(who) + calcCartTotal();
    if (after > toKurus(customers[ck].limit) && !confirm(ck + ' için veresiye limiti ' + money(toKurus(customers[ck].limit)) + '. Bu satırla borç ' + money(after) + ' olacak. Yine de yazılsın mı?')) return;
  }
  let total = 0, items = 0;
  lockOpening();
  const sid = Date.now();
  const lines = [];
  keys.forEach(k => {
    const qty = cart[k];
    const pr = priceOf(k);
    addLog({ type: 'sale', sid: sid, debt: who || undefined, cust: ck || undefined, key: k, name: products[k].name, qty: qty, price: pr });
    total += toKurus(pr) * qty;
    items += qty;
    lines.push({ name: products[k].name, qty: qty, price: pr });
    if (hasStock(products[k])) products[k].stock = Math.max(0, products[k].stock - qty);
  });
  saveProducts();
  if (who) { (debts[who] = debts[who] || []).push({ t: sid, a: total, items: lines }); saveJ('kantin_debt', debts); document.getElementById('debtName').value = ''; fillDebtNames(); }
  else if (ck) document.getElementById('debtName').value = '';
  cart = {};
  renderCart(); renderGrid(); renderRecent(); checkLowBanner();
  settings.salesSinceBk++; saveSet(); checkBkBanner();
  beep(880, 0.1); setTimeout(() => beep(1175, 0.12), 130);
  const paidRaw = document.getElementById('paidAmt').value.trim();
  const paid = paidRaw ? parsePrice(paidRaw) : NaN;
  const paidV = isNaN(paid) ? null : paid;
  if (settings.showReceipt === false) lastReceipt = { sid: sid, lines: lines, total: total, who: who, paid: paidV, cust: ck };
  else showReceipt(sid, lines, total, who, paidV, ck);
  if (ck && settings.autoWa && customers[ck].phone) waOpen(waUrl(customers[ck].phone, saleMsg(ck, sid, lines, total)));
  document.getElementById('paidAmt').value = ''; updateChange();
  showMsg('cart', '✅ Satış tamamlandı: ' + items + ' ürün, ' + money(total) + (who ? ' (veresiye: ' + who + ')' : ''), 'ok', 5000);
}
function clearCart() { if (Object.keys(cart).length === 0) return; cart = {}; renderCart(); updateChange(); }

function receiptHTML(sid, lines, total, who, paid) {
  let h = '<h3>🧾 Fiş</h3><div class="code">' + new Date(sid).toLocaleString('tr-TR') + (who ? '<br>Veresiye: ' + esc(who) : '') + '</div>';
  h += '<table><thead><tr><th>Ürün</th><th class="num">Adet</th><th class="num">Tutar</th></tr></thead><tbody>';
  lines.forEach(l => { h += '<tr><td>' + esc(l.name) + '</td><td class="num">' + l.qty + '</td><td class="num">' + money(toKurus(l.price) * l.qty) + '</td></tr>'; });
  h += '</tbody></table><div class="total" style="font-size:18px">Toplam: ' + money(total) + '</div>';
  if (paid !== null && paid !== undefined) {
    const ch = toKurus(paid) - total;
    h += '<div class="code">Alınan: ' + money(toKurus(paid)) + '</div>';
    h += '<div class="' + (ch < 0 ? 'diff bad' : 'diff ok') + '" style="font-size:16px">Para üstü: ' + money(Math.abs(ch)) + (ch < 0 ? ' (eksik!)' : '') + '</div>';
  }
  return h;
}
function showReceipt(sid, lines, total, who, paid, cust) {
  lastReceipt = { sid: sid, lines: lines, total: total, who: who, paid: paid, cust: cust };
  openModal(receiptHTML(sid, lines, total, who, paid) + waSaleButton(cust, sid, lines, total) +
    '<div class="row" style="margin-top:10px"><button class="btn-primary" style="flex:1" onclick="printLastReceipt()">🖨️ Yazdır</button><button class="btn-gray" style="flex:1" onclick="closeModal()">Kapat</button></div>');
}
function printLastReceipt() {
  if (!lastReceipt) return;
  const r = lastReceipt;
  printHTML('<h2>🏪 Kantin Fişi</h2><p>' + new Date(r.sid).toLocaleString('tr-TR') + (r.who ? ' · Veresiye: ' + esc(r.who) : '') + '</p>' + receiptHTML(r.sid, r.lines, r.total, r.who, r.paid));
}
function renderSaleHistory() {
  const box = document.getElementById('saleHist');
  box.innerHTML = '';
  const sd = document.getElementById('sumDate');
  if (!sd.value) sd.value = localISO(new Date());
  const parts = sd.value.split('-').map(Number);
  const sales = daySales(parts[0], parts[1] - 1, parts[2]);
  if (!sales.length) { box.innerHTML = '<p class="empty">Bu gün için satış yok.</p>'; return; }
  const groups = {};
  sales.forEach(l => { const g = l.sid || l.id; (groups[g] = groups[g] || []).push(l); });
  Object.keys(groups).sort((a, b) => Number(b) - Number(a)).forEach(g => {
    const ls = groups[g];
    const tot = ls.reduce((s, l) => s + l.qty * toKurus(l.price), 0);
    const t = document.createElement('table'); const tb = document.createElement('tbody');
    const tr = document.createElement('tr'); tr.className = 'strong';
    const a = document.createElement('td');
    a.textContent = new Date(ls[0].t).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) + (ls[0].debt ? ' · 📒 ' + ls[0].debt : '');
    const b = document.createElement('td'); b.className = 'num'; b.textContent = money(tot);
    const c = document.createElement('td'); c.className = 'num';
    c.appendChild(mkBtn('Fiş', 'btn-primary', () => printSaleGroup(ls)));
    const wk = customerKey(ls[0].debt || ls[0].cust || '');
    if (wk && customers[wk].phone) c.appendChild(mkBtn('📱', 'btn-success', () => waOpen(waUrl(customers[wk].phone, saleMsg(wk, ls[0].t, ls.map(l => ({ name: l.name, qty: l.qty, price: l.price })), tot)))));
    c.appendChild(mkBtn('İptal', 'btn-danger', () => cancelSaleGroup(ls)));
    tr.appendChild(a); tr.appendChild(b); tr.appendChild(c); tb.appendChild(tr);
    ls.forEach(l => {
      const r = document.createElement('tr');
      const x = document.createElement('td'); x.textContent = l.name + ' × ' + l.qty;
      const z = document.createElement('td'); z.className = 'num'; z.textContent = money(l.qty * toKurus(l.price));
      const w = document.createElement('td'); w.className = 'num';
      w.appendChild(mkBtn('✕', 'btn-danger', () => cancelSaleLine(l.id)));
      r.appendChild(x); r.appendChild(z); r.appendChild(w); tb.appendChild(r);
    });
    t.appendChild(tb); box.appendChild(t);
  });
}
function printSaleGroup(ls) {
  const sid = ls[0].sid || ls[0].id;
  const tot = ls.reduce((s, l) => s + l.qty * toKurus(l.price), 0);
  printHTML('<h2>🏪 Kantin Fişi</h2><p>' + new Date(ls[0].t).toLocaleString('tr-TR') + (ls[0].debt ? ' · Veresiye: ' + esc(ls[0].debt) : '') + '</p>' +
    receiptHTML(sid, ls.map(l => ({ name: l.name, qty: l.qty, price: l.price })), tot, ls[0].debt, null));
}
function cancelSaleGroup(ls) {
  const tot = ls.reduce((s, l) => s + l.qty * toKurus(l.price), 0);
  if (!confirm('Bu satış (' + money(tot) + ') iptal edilsin mi? Stoklar geri eklenir.')) return;
  ls.forEach(l => { if (products[l.key] && hasStock(products[l.key])) products[l.key].stock += l.qty; });
  const who = ls[0].debt;
  if (who && debts[who]) { debts[who].push({ t: Date.now(), a: -tot, note: 'Satış iptali' }); saveJ('kantin_debt', debts); }
  logs = logs.filter(l => ls.indexOf(l) < 0); saveJ('kantin_log', logs);
  saveProducts(); renderOverview(); renderGrid(); checkLowBanner();
  showMsg('sm', '↩️ Satış iptal edildi.', 'ok');
}
function cancelSaleLine(id) {
  const i = logs.findIndex(l => l.id === id); if (i < 0) return;
  const l = logs[i];
  if (!confirm(l.name + ' × ' + l.qty + ' iptal edilsin mi?')) return;
  if (products[l.key] && hasStock(products[l.key])) products[l.key].stock += l.qty;
  if (l.debt && debts[l.debt]) { debts[l.debt].push({ t: Date.now(), a: -l.qty * toKurus(l.price), note: 'Kalem iptali' }); saveJ('kantin_debt', debts); }
  logs.splice(i, 1); saveJ('kantin_log', logs);
  saveProducts(); renderOverview(); renderGrid(); checkLowBanner();
  showMsg('sm', '↩️ Kalem iptal edildi.', 'ok');
}
function zReport() {
  const sd = document.getElementById('sumDate');
  const dt = sd.value || localISO(new Date());
  const parts = dt.split('-').map(Number);
  const sales = daySales(parts[0], parts[1] - 1, parts[2]);
  let total = 0, items = 0, credit = 0, profit = 0;
  const agg = {};
  sales.forEach(l => {
    const line = l.qty * toKurus(l.price);
    total += line; items += l.qty;
    if (l.debt) credit += line;
    const c = products[l.key] && products[l.key].cost;
    if (c) profit += line - l.qty * toKurus(c);
    agg[l.name] = (agg[l.name] || 0) + l.qty;
  });
  let h = '<h2>🏪 Gün Sonu Raporu (Z)</h2><p>' + new Date(parts[0], parts[1] - 1, parts[2]).toLocaleDateString('tr-TR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) + '</p><table><tbody>';
  const row = (a, b) => '<tr><td>' + a + '</td><td class="num">' + b + '</td></tr>';
  h += row('Satış tutarı', '<b>' + money(total) + '</b>') + row('Satılan adet', String(items)) +
       row('Tahmini kâr (alış bilinenler)', money(profit)) + row('Veresiye satış', money(credit)) +
       row('Nakit tahmini', money(total - credit)) + '</tbody></table>';
  const names = Object.keys(agg).sort((a, b) => agg[b] - agg[a]);
  if (names.length) h += '<h3>Ürün bazlı satış</h3><table><tbody>' + names.map(n => row(esc(n), agg[n] + ' adet')).join('') + '</tbody></table>';
  printHTML(h);
}

// ===== Ürün Ekle / Düzenle =====
function saveProduct() {
  const name = document.getElementById('newName').value.trim();
  const price = parsePrice(document.getElementById('newPrice').value);
  const price2 = parsePrice(document.getElementById('newPrice2').value);
  const cat = document.getElementById('newCat').value.trim();
  let code = document.getElementById('newCode').value.trim();
  const stock = parseStock(document.getElementById('newStock').value);

  if (isNaN(stock)) { showMsg('define', 'Stok için 0 veya daha büyük bir tam sayı girin.', 'err'); return; }
  if (!name) { showMsg('define', 'Ürün adını girin.', 'err'); return; }
  if (isNaN(price) || price < 0) { showMsg('define', 'Geçerli bir fiyat girin.', 'err'); return; }

  if (editingKey) {
    if (!code) code = editingKey;
    if (code !== editingKey && findKey(code)) { showMsg('define', 'Bu kod başka bir üründe kullanılıyor: ' + products[findKey(code)].name, 'err'); return; }
    const oldP = products[editingKey] || {};
    const rec = Object.assign({}, oldP, { name: name, price: price });
    if (stock === null) delete rec.stock; else rec.stock = stock;
    if (cat) rec.cat = cat; else delete rec.cat;
    if (!isNaN(price2) && price2 > 0) rec.price2 = price2; else delete rec.price2;
    if (oldP.price !== undefined && oldP.price !== price) rec.ph = (oldP.ph || []).concat([{ t: Date.now(), old: oldP.price, new: price }]).slice(-10);
    if (code !== editingKey) { delete products[editingKey]; if (cart[editingKey]) { cart[code] = cart[editingKey]; delete cart[editingKey]; } }
    products[code] = rec;
    saveProducts(); cancelEdit();
    showMsg('define', '✅ "' + name + '" güncellendi.', 'ok');
    return;
  }

  if (!code) code = newAutoCode();
  const existing = findKey(code);
  if (existing) { showMsg('define', 'Bu kod zaten tanımlı: ' + products[existing].name, 'err'); return; }

  const rec = { name: name, price: price };
  if (stock !== null) rec.stock = stock;
  if (!isNaN(price2) && price2 > 0) rec.price2 = price2;
  if (cat) rec.cat = cat;
  products[code] = rec;
  saveProducts();
  document.getElementById('newName').value = '';
  document.getElementById('newPrice').value = '';
  document.getElementById('newPrice2').value = '';
  document.getElementById('newCat').value = '';
  document.getElementById('newStock').value = '';
  document.getElementById('newCode').value = '';
  showMsg('define', '✅ "' + name + '" eklendi. Kodu: ' + code, 'ok', 5000);
  document.getElementById('newName').focus();
}
function startEdit(key) {
  editingKey = key;
  showTab('define');
  editingKey = key;
  document.getElementById('defineTitle').textContent = '✏️ Ürünü Düzenle';
  document.getElementById('newName').value = products[key].name;
  document.getElementById('newPrice').value = String(products[key].price).replace('.', ',');
  document.getElementById('newPrice2').value = products[key].price2 ? String(products[key].price2).replace('.', ',') : '';
  document.getElementById('newCat').value = products[key].cat || '';
  document.getElementById('newStock').value = hasStock(products[key]) ? String(products[key].stock) : '';
  document.getElementById('newCode').value = key;
  document.getElementById('saveBtn').textContent = 'Değişiklikleri Kaydet';
  document.getElementById('cancelEditBtn').classList.remove('hidden');
}
function cancelEdit() {
  editingKey = null;
  document.getElementById('defineTitle').textContent = '➕ Yeni Ürün';
  document.getElementById('newName').value = '';
  document.getElementById('newPrice').value = '';
  document.getElementById('newPrice2').value = '';
  document.getElementById('newCat').value = '';
  document.getElementById('newStock').value = '';
  document.getElementById('newCode').value = '';
  document.getElementById('saveBtn').textContent = 'Ürünü Kaydet';
  document.getElementById('cancelEditBtn').classList.add('hidden');
}
function renderProductList() {
  const list = document.getElementById('productList');
  list.innerHTML = '';
  const keys = Object.keys(products).sort((a, b) => products[a].name.localeCompare(products[b].name, 'tr'));
  if (keys.length === 0) { const p = document.createElement('p'); p.className = 'empty'; p.textContent = 'Henüz ürün tanımlanmadı.'; list.appendChild(p); return; }
  const table = document.createElement('table');
  const thead = document.createElement('thead');
  thead.innerHTML = '<tr><th>Ürün</th><th class="num">Fiyat</th><th></th></tr>';
  table.appendChild(thead);
  const tbody = document.createElement('tbody');
  keys.forEach(key => {
    const p = products[key];
    const tr = document.createElement('tr');
    const n = document.createElement('td');
    const nm = document.createElement('div'); nm.textContent = p.name + (p.price2 ? ' / ' + money(toKurus(p.price2)) : '');
    const cd = document.createElement('div'); cd.className = 'code';
    cd.textContent = key + (hasStock(p) ? ' · Raf: ' + p.stock : '') + (p.depo > 0 ? ' · Depo: ' + p.depo : '') + (p.cat ? ' · ' + p.cat : '');
    n.appendChild(nm); n.appendChild(cd);
    const f = document.createElement('td'); f.className = 'num'; f.textContent = money(toKurus(p.price));
    const a = document.createElement('td'); a.className = 'actions';
    const hist = document.createElement('button'); hist.className = 'small btn-gray'; hist.textContent = 'Geçmiş'; hist.onclick = () => showProductHistory(key);
    const edit = document.createElement('button'); edit.className = 'small btn-primary'; edit.textContent = 'Düzenle'; edit.onclick = () => startEdit(key);
    const del = document.createElement('button'); del.className = 'small btn-danger'; del.textContent = 'Sil'; del.onclick = () => deleteProduct(key);
    a.appendChild(hist); a.appendChild(edit); a.appendChild(del);
    tr.appendChild(n); tr.appendChild(f); tr.appendChild(a);
    tbody.appendChild(tr);
  });
  table.appendChild(tbody);
  list.appendChild(table);
}
function showProductHistory(k) {
  const p = products[k];
  if (!p) return;
  let h = '<h3>📋 ' + esc(p.name) + '</h3><p class="code">' + esc(k) + ' · Raf: ' + expectedOf(k) + ' · Depo: ' + (p.depo || 0) + '</p>';
  if (p.ph && p.ph.length) {
    h += '<h4 style="margin-top:10px">Fiyat geçmişi</h4>';
    p.ph.slice().reverse().forEach(r => { h += '<div class="code">' + new Date(r.t).toLocaleDateString('tr-TR') + ': ' + r.old + ' → ' + r.new + ' ₺</div>'; });
  }
  h += '<h4 style="margin-top:10px">Hareketler (son 50)</h4>';
  const ls = logs.filter(l => l.key === k).slice().reverse().slice(0, 50);
  if (!ls.length) h += '<p class="empty">Kayıtlı hareket yok.</p>';
  else {
    h += '<table><tbody>';
    ls.forEach(l => {
      const tp = l.type === 'sale' ? 'Satış' : (l.type === 'in' ? 'Mal girişi' : (l.kind === 'İade' ? 'İade' : 'Fire'));
      const amt = l.type === 'in' ? l.qty * toKurus(l.cost || 0) : l.qty * toKurus(l.price);
      h += '<tr><td>' + new Date(l.t).toLocaleDateString('tr-TR') + '</td><td>' + tp + '</td><td class="num">' + l.qty + ' adet</td><td class="num">' + money(amt) + '</td></tr>';
    });
    h += '</tbody></table>';
  }
  h += '<button class="btn-gray" style="margin-top:10px" onclick="closeModal()">Kapat</button>';
  openModal(h);
}
function deleteProduct(key) {
  if (confirm('"' + products[key].name + '" ürününü silmek istediğinize emin misiniz?')) {
    delete products[key]; delete cart[key];
    saveProducts(); renderProductList(); renderCart(); checkLowBanner();
  }
}

