function debtAgeDays(n) {
  const q = [];
  (debts[n] || []).forEach(e => {
    if (e.a > 0) q.push({ t: e.t, a: e.a });
    else {
      let r = -e.a;
      while (r > 0 && q.length) { const x = q[0]; if (x.a <= r) { r -= x.a; q.shift(); } else { x.a -= r; r = 0; } }
    }
  });
  return q.length ? Math.max(0, Math.floor((Date.now() - q[0].t) / 86400000)) : 0;
}
function remDebtors() {
  const minAge = parseInt($('remAge').value, 10) || 0;
  return Object.keys(debts).filter(n => bal(n) > 0 && debtAgeDays(n) >= minAge)
    .sort((a, b) => debtAgeDays(b) - debtAgeDays(a) || bal(b) - bal(a));
}
