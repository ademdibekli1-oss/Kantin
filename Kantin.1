  showMsg('wm', 'Şablonlar varsayılana döndü.', 'ok');
}

// ===== PWA =====
try {
  const iconSvg = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="20" fill="#1a3c6e"/><text x="50" y="68" font-size="52" text-anchor="middle">🏪</text></svg>');
  const man = { name: 'Kantin Satış', short_name: 'Kantin', display: 'standalone', background_color: '#1a3c6e', theme_color: '#1a3c6e', start_url: '.', icons: [{ src: iconSvg, sizes: 'any', type: 'image/svg+xml', purpose: 'any' }] };
  $('pwaManifest').href = 'data:application/manifest+json,' + encodeURIComponent(JSON.stringify(man));
