let qState = null;
function startQueue(title, items) {
  if (!items.length) { showMsg('wm', 'Gönderilecek kişi yok.', 'info'); return; }
  qState = { title: title, items: items, i: 0, sent: 0 };
  renderQueue();
}
function renderQueue() {
  const q = qState; if (!q) return;
  const it = q.items[q.i];
  if (!it) {
    openModal('<h3>✅ Tamamlandı</h3><p>' + q.sent + ' / ' + q.items.length + ' kişi için WhatsApp açıldı.</p><button class="btn-gray" onclick="closeModal()">Kapat</button>');
    qState = null; renderRem(); return;
  }
  openModal('<h3>' + esc(q.title) + '</h3><div class="code">' + (q.i + 1) + ' / ' + q.items.length + '</div>' +
    '<div style="font-weight:bold;margin-top:6px">' + esc(it.name) + '</div><div class="code">' + esc(fmtPhone(it.phone)) + '</div>' +
    '<div class="msgprev">' + esc(it.text) + '</div>' +
    '<a class="btn-wa" id="qGo" target="_blank" rel="noopener" href="' + esc(waUrl(it.phone, it.text)) + '">📱 WhatsApp\'ı Aç</a>' +
    '<div class="row" style="margin-top:8px"><button class="btn-gray" id="qSkip" style="flex:1;margin-top:0">Atla</button><button class="btn-gray" id="qCopy" style="flex:1;margin-top:0">Kopyala</button><button class="btn-danger" id="qStop" style="flex:1;margin-top:0">Bitir</button></div>' +
    '<p class="hint" style="margin-top:8px">WhatsApp açılınca "Gönder"e basın, sonra uygulamaya dönüp sıradakine geçin.</p>');
  $('qGo').onclick = () => { q.sent++; if (it.onSent) it.onSent(); setTimeout(() => { q.i++; renderQueue(); }, 400); };
  $('qSkip').onclick = () => { q.i++; renderQueue(); };
  $('qCopy').onclick = () => { copyText(it.text, 'wm'); $('qCopy').textContent = '✓ Kopyalandı'; };
  $('qStop').onclick = () => { qState = null; closeModal(); renderRem(); };
}
function daySummaryText(dateStr) {
  const pr = dateStr.split('-').map(Number);
  const ls = daySales(pr[0], pr[1] - 1, pr[2]);
  let total = 0, items = 0, credit = 0, profit = 0; const agg = {};
  ls.forEach(l => {
    const line = l.qty * toKurus(l.price); total += line; items += l.qty;
    if (l.debt) credit += line;
    const c = products[l.key] && products[l.key].cost; if (c) profit += line - l.qty * toKurus(c);
    agg[l.name] = (agg[l.name] || 0) + l.qty;
  });
  const top = Object.keys(agg).sort((a, b) => agg[b] - agg[a]).slice(0, 3).map(n => n + ' (' + agg[n] + ')');
  const low = Object.keys(products).filter(k => hasStock(products[k]) && totalOf(k) <= settings.critTh);
  let open = 0; Object.keys(debts).forEach(n => { open += Math.max(0, bal(n)); });
  let t = '📊 Kantin günlük özet — ' + new Date(pr[0], pr[1] - 1, pr[2]).toLocaleDateString('tr-TR') +
    '\nSatış: ' + money(total) + ' (' + items + ' adet)' +
    '\nNakit: ' + money(total - credit) + ' · Veresiye: ' + money(credit) +
    '\nTahmini kâr: ' + money(profit);
  if (top.length) t += '\nEn çok satan: ' + top.join(', ');
  t += '\nAçık veresiye alacağı: ' + money(open);
  if (low.length) t += '\nAzalan stok: ' + low.length + ' ürün (' + low.slice(0, 5).map(k => products[k].name).join(', ') + (low.length > 5 ? ' ...' : '') + ')';
  return t;
}
function renderDaySummaryPreview() { $('dsPrev').textContent = daySummaryText($('dsDate').value || localISO(new Date())); }
function shareDaySummary() {
  const raw = $('dsPhone').value.trim();
  let phone = '';
  if (raw) {
    phone = normPhone(raw);
    if (!phone) { showMsg('wm', 'Geçerli bir cep telefonu girin ya da boş bırakın.', 'err'); return; }
    settings.ownPhone = phone; saveSet();
  }
  waOpen(waUrl(phone, daySummaryText($('dsDate').value || localISO(new Date()))));
}
function setAutoWaPref() { settings.autoWa = $('setAutoWa').checked; saveSet(); }
