const bc = c => ({ txt: String(c) });
function csvCell(v) {
  if (v && typeof v === 'object') return '="' + v.txt + '"';
  if (typeof v === 'number') return String(Math.round(v * 100) / 100).replace('.', ',');
  const t = String(v == null ? '' : v);
  return (t.indexOf(';') >= 0 || t.indexOf('"') >= 0 || t.indexOf('\n') >= 0) ? '"' + t.replace(/"/g, '""') + '"' : t;
}
function tsvCell(v) {
  if (v && typeof v === 'object') return v.txt;
  if (typeof v === 'number') return String(Math.round(v * 100) / 100).replace('.', ',');
  return String(v == null ? '' : v).replace(/[\t\r\n]+/g, ' ');
}
function sendTable(fileName, rows, msgMode, info) {
  download(fileName, '\uFEFF' + rows.map(r => r.map(csvCell).join(';')).join('\r\n'), 'text/csv;charset=utf-8');
  copyText(rows.map(r => r.map(tsvCell).join('\t')).join('\n'));
  showMsg(msgMode, info + " Dosya inmediyse panoya kopyalandı, Excel'e yapıştırabilirsiniz.", 'info', 8000);
}
