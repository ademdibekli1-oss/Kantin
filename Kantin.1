const $ = id => document.getElementById(id);
function loadJ(k, d) { try { const v = JSON.parse(localStorage.getItem(k)); return v === null ? d : v; } catch (e) { return d; } }
function saveJ(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
let logs = loadJ('kantin_log', []);
let meta = loadJ('kantin_meta', null);
let counts = loadJ('kantin_count', {});
let hist = loadJ('kantin_hist', []);
let debts = loadJ('kantin_debt', {});
if (!meta) { meta = { start: Date.now(), opening: 0, auto: true }; saveJ('kantin_meta', meta); }

function expectedOf(k) { return hasStock(products[k]) ? products[k].stock : 0; }
function depoOf(k) { return (products[k] && products[k].depo > 0) ? products[k].depo : 0; }
function totalOf(k) { return expectedOf(k) + depoOf(k); }
function stockValue() { return Object.keys(products).reduce((s, k) => s + totalOf(k) * toKurus(products[k].price), 0); }
function lockOpening() { if (meta.auto) { meta.opening = stockValue(); meta.auto = false; saveJ('kantin_meta', meta); } }
function openingValue() { return meta.auto ? stockValue() : meta.opening; }
function addLog(e) {
  logs.push(Object.assign({ id: Date.now() + Math.random(), t: Date.now() }, e));
  if (logs.length > 3000) logs = logs.slice(-3000);
  saveJ('kantin_log', logs);
}
function periodLogs(type) { return logs.filter(l => l.type === type && l.t >= meta.start); }
function calc() {
  const ins = periodLogs('in'), sales = periodLogs('sale');
  const A = openingValue();
  const B = ins.reduce((s, l) => s + l.qty * toKurus(l.price), 0);
  const X = ins.reduce((s, l) => s + l.qty * toKurus(l.cost || 0), 0);
  const S = sales.reduce((s, l) => s + l.qty * toKurus(l.price), 0);
  let C = 0, uncounted = 0;
  Object.keys(products).forEach(k => {
    const c = counts[k] === undefined ? expectedOf(k) : counts[k];
    if (counts[k] === undefined) uncounted++;
    C += (c + depoOf(k)) * toKurus(products[k].price);
  });
  return { A: A, B: B, X: X, S: S, C: C, E: stockValue(), uncounted: uncounted, I: lossVal('İade'), F: lossVal('Fire') };
}
function addRow(tbody, label, value, strong) {
  const tr = document.createElement('tr'); if (strong) tr.className = 'strong';
  const a = document.createElement('td'); a.className = 'lbl'; a.textContent = label;
  const b = document.createElement('td'); b.className = 'num'; b.textContent = value;
  tr.appendChild(a); tr.appendChild(b); tbody.appendChild(tr);
}
function fmtDate(t) { return new Date(t).toLocaleDateString('tr-TR'); }
function renderCount() { renderInSelect(); renderMonth(); renderIns(); renderCountList(); renderResult(); renderHist(); }
function renderMonth() {
  const c = calc();
  $('periodInfo').textContent = fmtDate(meta.start) + ' tarihinden bu yana';
  const t = $('monthBody'); t.innerHTML = '';
  addRow(t, 'Alışveriş (alış fiyatıyla)', money(c.X), true);
  addRow(t, 'Alınan mal (satış değeriyle)', money(c.B));
  addRow(t, 'Kayıtlı satış', money(c.S));
  addRow(t, 'Elde olması gereken mal (raf + depo)', money(c.E));
}
function renderInSelect() {
  const sel = $('inProduct'), cur = sel.value;
  sel.innerHTML = '';
  Object.keys(products).sort((a, b) => products[a].name.localeCompare(products[b].name, 'tr')).forEach(k => {
    const o = document.createElement('option'); o.value = k;
    o.textContent = products[k].name + ' (raf: ' + expectedOf(k) + ', depo: ' + (products[k].depo || 0) + ')';
    sel.appendChild(o);
  });
  if (cur && products[cur]) sel.value = cur;
  fillCost();
}
function fillCost() {
  const p = products[$('inProduct').value];
  $('inCost').value = p && p.cost ? String(p.cost).replace('.', ',') : '';
}
function saveIn() {
  const key = $('inProduct').value, p = products[key];
  const qty = parseInt($('inQty').value, 10);
  const cost = parsePrice($('inCost').value);
  if (!p) { showMsg('inm', 'Önce bir ürün seçin.', 'err'); return; }
  if (isNaN(qty) || qty <= 0) { showMsg('inm', 'Adet için 1 veya daha büyük bir sayı girin.', 'err'); return; }
  lockOpening();
  const c = isNaN(cost) ? (p.cost || 0) : cost;
  p.depo = (p.depo || 0) + qty;
  if (c > 0) p.cost = c;
  saveProducts();
  addLog({ type: 'in', key: key, name: p.name, qty: qty, price: p.price, cost: c });
  $('inQty').value = '';
  showMsg('inm', '✅ ' + qty + ' adet ' + p.name + ' depoya eklendi. Depo: ' + p.depo, 'ok');
  renderCount(); renderGrid(); checkLowBanner();
}
function renderIns() {
  const box = $('inList'); box.innerHTML = '';
  const list = periodLogs('in').slice().reverse();
  if (!list.length) return;
  const table = document.createElement('table'); const tb = document.createElement('tbody');
  list.forEach(l => {
    const tr = document.createElement('tr');
    const a = document.createElement('td'); a.textContent = l.name;
    const d = document.createElement('div'); d.className = 'code'; d.textContent = fmtDate(l.t) + ' · ' + l.qty + ' adet (depo)'; a.appendChild(d);
    const b = document.createElement('td'); b.className = 'num'; b.textContent = money(l.qty * toKurus(l.cost || 0));
    const c = document.createElement('td'); c.className = 'num';
    const x = document.createElement('button'); x.className = 'small btn-danger'; x.textContent = 'Geri al';
    x.onclick = () => undoIn(l.id); c.appendChild(x);
    tr.appendChild(a); tr.appendChild(b); tr.appendChild(c); tb.appendChild(tr);
  });
  table.appendChild(tb); box.appendChild(table);
}
function undoIn(id) {
  const i = logs.findIndex(l => l.id === id); if (i < 0) return;
  const l = logs[i];
  if (!confirm(l.qty + ' adet ' + l.name + ' girişi geri alınsın mı? Stok o kadar azalır.')) return;
  if (products[l.key]) {
    const pp = products[l.key], fd = Math.min(depoOf(l.key), l.qty);
    pp.depo = depoOf(l.key) - fd;
    if (l.qty > fd) pp.stock = Math.max(0, expectedOf(l.key) - (l.qty - fd));
  }
  logs.splice(i, 1); saveJ('kantin_log', logs); saveProducts(); renderCount(); renderGrid(); checkLowBanner();
}
function renderCountList() {
  const box = $('countList'); box.innerHTML = '';
  const q = $('countSearch').value.trim().toLocaleLowerCase('tr-TR'), f = $('countFilter').value;
  const keys = Object.keys(products)
    .filter(k => products[k].name.toLocaleLowerCase('tr-TR').includes(q))
    .filter(k => f === 'all' || (f === 'un' && counts[k] === undefined) || (f === 'diff' && counts[k] !== undefined && counts[k] !== expectedOf(k)))
    .sort((a, b) => products[a].name.localeCompare(products[b].name, 'tr'));
  const table = document.createElement('table'); const tb = document.createElement('tbody');
  keys.forEach(k => {
    const tr = document.createElement('tr');
    const n = document.createElement('td'); n.textContent = products[k].name;
    const e = document.createElement('div'); e.className = 'code'; e.textContent = 'Beklenen (raf): ' + expectedOf(k) + (products[k].depo > 0 ? ' · Depo: ' + products[k].depo : ''); n.appendChild(e);
    const i = document.createElement('td');
    const inp = document.createElement('input'); inp.className = 'cin'; inp.type = 'text'; inp.inputMode = 'numeric'; inp.placeholder = '–';
    inp.value = counts[k] === undefined ? '' : String(counts[k]);
    i.appendChild(inp);
    const d = document.createElement('td'); d.className = 'num';
    const sp = document.createElement('span'); d.appendChild(sp);
    const paint = () => {
      if (counts[k] === undefined) { sp.textContent = ''; return; }
      const df = counts[k] - expectedOf(k);
      sp.className = 'diff ' + (df === 0 ? 'ok' : 'bad');
      sp.textContent = df === 0 ? '✓' : (df > 0 ? '+' : '−') + Math.abs(df);
    };
    paint();
    inp.oninput = () => {
      const v = parseStock(inp.value);
      if (inp.value.trim() === '' || isNaN(v)) delete counts[k]; else counts[k] = v;
      saveJ('kantin_count', counts); paint(); renderResult();
    };
    tr.appendChild(n); tr.appendChild(i); tr.appendChild(d); tb.appendChild(tr);
  });
  table.appendChild(tb); box.appendChild(table);
  if (!keys.length) { const p = document.createElement('p'); p.className = 'empty'; p.textContent = 'Gösterilecek ürün yok.'; box.appendChild(p); }
  updProgress();
}
function updProgress() {
  const total = Object.keys(products).length, done = Object.keys(counts).filter(k => products[k]).length;
  $('countProgress').textContent = done + ' / ' + total + ' ürün sayıldı';
}
$('countScan').addEventListener('keydown', e => {
  if (e.key !== 'Enter') return;
  e.preventDefault();
  const code = e.target.value.trim(); e.target.value = '';
  if (!code) return;
  const k = findKey(code);
  if (!k) { showMsg('cnt', 'Bu kod tanımlı değil: ' + code, 'err'); return; }
  counts[k] = (counts[k] === undefined ? 0 : counts[k]) + 1;
  saveJ('kantin_count', counts);
  beep(700, 0.05);
  showMsg('cnt', products[k].name + ': ' + counts[k] + ' (beklenen ' + expectedOf(k) + ')', counts[k] === expectedOf(k) ? 'ok' : 'info', 2500);
  renderCountList(); renderResult();
});
function renderResult() {
  const c = calc(), t = $('resultBody'); t.innerHTML = '';
  addRow(t, 'Devreden mal', money(c.A));
  addRow(t, 'Ay içinde giren mal', money(c.B));
  addRow(t, 'İade mal', money(c.I));
  addRow(t, 'Toplam mal', money(c.A + c.B - c.I));
  addRow(t, 'Sayılan mal', money(c.C));
  addRow(t, 'Fire', money(c.F));
  addRow(t, 'Olması gereken hasılat', money(c.A + c.B - c.I - c.C - c.F), true);
  addRow(t, 'Beklenen stoğa göre fark', (c.C - c.E >= 0 ? '+' : '−') + money(Math.abs(c.C - c.E)));
  if (c.uncounted) addRow(t, 'Sayılmayan ürün', c.uncounted + ' adet (beklenen stokla hesaplandı)');
}
function resetCount() {
  if (!Object.keys(counts).length || !confirm('Girilen tüm sayımlar silinsin mi?')) return;
  counts = {}; saveJ('kantin_count', counts); renderCount();
}
function finishCount() {
  const c = calc();
  const msg = 'Stoklar sayılan adetlere göre güncellenecek ve yeni ay başlayacak.' +
    (c.uncounted ? ' ' + c.uncounted + ' ürün sayılmadı, stokları aynen kalır.' : '') + ' Devam edilsin mi?';
  if (!confirm(msg)) return;
  lockOpening();
  hist.unshift({ t: Date.now(), start: meta.start, opening: c.A, inVal: c.B, alis: c.X, counted: c.C, due: c.A + c.B - c.I - c.C - c.F, sales: c.S });
  hist = hist.slice(0, 12); saveJ('kantin_hist', hist);
  Object.keys(counts).forEach(k => { if (products[k]) products[k].stock = counts[k]; });
  saveProducts();
  counts = {}; saveJ('kantin_count', counts);
  meta = { start: Date.now(), opening: stockValue(), auto: false }; saveJ('kantin_meta', meta);
  renderCount(); renderGrid(); checkLowBanner();
  showMsg('cnt', '✅ Sayım kaydedildi, yeni ay başladı.', 'ok', 5000);
}
function renderHist() {
  const box = $('histList'); box.innerHTML = '';
  if (!hist.length) { const p = document.createElement('p'); p.className = 'empty'; p.textContent = 'Henüz tamamlanmış sayım yok.'; box.appendChild(p); return; }
  const table = document.createElement('table');
  table.innerHTML = '<thead><tr><th>Dönem</th><th class="num">Sayılan</th><th class="num">Hasılat</th><th class="num">Alışveriş</th></tr></thead>';
  const tb = document.createElement('tbody');
  hist.forEach(h => {
    const tr = document.createElement('tr');
    [fmtDate(h.start) + ' – ' + fmtDate(h.t), money(h.counted), money(h.due), money(h.alis)].forEach((v, i) => {
      const td = document.createElement('td'); if (i) td.className = 'num'; td.textContent = v; tr.appendChild(td);
    });
    tb.appendChild(tr);
  });
  table.appendChild(tb); box.appendChild(table);
}

// ===== Özet =====
function localISO(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
function daySales(y, m, d) {
  const a = new Date(y, m, d).getTime(), b = new Date(y, m, d + 1).getTime();
  return logs.filter(l => l.type === 'sale' && l.t >= a && l.t < b);
}
function renderOverview() {
  let qty = 0, val = 0, cost = 0, kinds = 0, noCost = 0, dQty = 0, dVal = 0;
  const out = [], low = [], shelf = [];
  Object.keys(products).forEach(k => {
    const p = products[k];
    if (p.depo > 0) { dQty += p.depo; dVal += p.depo * toKurus(p.cost || p.price); }
    if (!hasStock(p)) return;
    qty += p.stock; val += p.stock * toKurus(p.price);
    if (p.cost) cost += p.stock * toKurus(p.cost); else if (p.stock > 0) noCost++;
    const tot = p.stock + (p.depo > 0 ? p.depo : 0);
    if (tot > 0) kinds++;
    if (tot <= 0) out.push(p.name); else if (tot <= settings.critTh) low.push(p.name + ' (' + tot + ')');
    if (p.stock <= 0 && p.depo > 0) shelf.push(p.name + ' (depo: ' + p.depo + ')');
  });
  const st = $('stockBody'); st.innerHTML = '';
  addRow(st, 'Rafta satış değeriyle', money(val), true);
  addRow(st, 'Rafta alış değeriyle' + (noCost ? ' (' + noCost + ' ürün alışsız)' : ''), money(cost));
  addRow(st, 'Rafta toplam adet', String(qty));
  addRow(st, 'Stokta olan çeşit (raf + depo)', String(kinds));
  addRow(st, 'Tamamen biten çeşit', String(out.length));
  addRow(st, 'Depodaki adet', String(dQty));
  addRow(st, 'Depodaki mal (alış değeriyle)', money(dVal));
  $('stockOut').textContent = out.length ? 'Tamamen biten: ' + out.join(', ') : '';
  $('stockLow').textContent = low.length ? 'Azalan (' + settings.critTh + ' ve altı, raf + depo): ' + low.join(', ') : '';
  $('stockShelf').textContent = shelf.length ? 'Rafa taşınmalı (rafta yok, depoda var): ' + shelf.join(', ') : '';
  const sd = $('sumDate'); if (!sd.value) sd.value = localISO(new Date());
  const parts = sd.value.split('-').map(Number);
  const y = parts[0], m = parts[1] - 1, d = parts[2];
  const sales = daySales(y, m, d);
  const a = new Date(y, m, d).getTime(), b = new Date(y, m, d + 1).getTime();
  const ins = logs.filter(l => l.type === 'in' && l.t >= a && l.t < b);
  let total = 0, items = 0, profit = 0, creditDay = 0;
  const agg = {}, cats = {};
  sales.forEach(l => {
    const line = l.qty * toKurus(l.price); total += line; items += l.qty;
