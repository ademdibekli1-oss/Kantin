function importSeed() {
  const norm = t => String(t).toLocaleLowerCase('tr-TR').replace(/\s+/g, ' ').trim();
  const byName = {};
  Object.keys(products).forEach(k => { byName[norm(products[k].name)] = k; });
  const el = document.getElementById('importMsg');
  const say = (text, type) => {
    el.className = 'msg ' + type; el.textContent = text;
    clearTimeout(msgTimers.imp); msgTimers.imp = setTimeout(() => { el.className = 'msg'; }, 7000);
  };
  if (!confirm(SEED.length + ' ürün yüklenecek. Aynı isimli ürünlerde fiyat, stok, depo ve kategori korunur; eksik barkod ve alış fiyatı tamamlanır. Devam edilsin mi?')) return;
  let added = 0, updated = 0, skipped = 0;
  SEED.forEach(([barcode, name, price, stock, cost]) => {
    const oldKey = byName[norm(name)];
    const clash = findKey(barcode);
    if (oldKey) {
      if (clash && clash !== oldKey) { skipped++; return; }
      const old = products[oldKey];
      delete products[oldKey];
      if (cart[oldKey] && oldKey !== barcode) { cart[barcode] = cart[oldKey]; delete cart[oldKey]; }
      const rec = Object.assign({}, old, { name: name, x: 1 });
      if (!hasStock(rec)) rec.stock = stock;
      if (!(rec.price > 0)) rec.price = price;
      if (!rec.cost) rec.cost = cost;
      products[barcode] = rec;
      updated++;
    } else {
      if (clash) { skipped++; return; }
      products[barcode] = { name: name, price: price, stock: stock, cost: cost, x: 1 };
      added++;
    }
  });
  saveProducts(); renderProductList(); renderGrid(); renderCart(); checkLowBanner();
  say('✅ ' + updated + ' ürün güncellendi, ' + added + ' yeni ürün eklendi' + (skipped ? ', ' + skipped + ' ürün barkod çakışması nedeniyle atlandı' : '') + '.', 'ok');
}

