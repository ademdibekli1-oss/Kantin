  if (q > onShelf + inDepo) { showMsg('tl', 'Elde yalnızca ' + (onShelf + inDepo) + ' adet var (raf ' + onShelf + ', depo ' + inDepo + ').', 'err'); return; }
  lockOpening();
  const fromShelf = Math.min(onShelf, q);
  p.stock = onShelf - fromShelf;
  if (q > fromShelf) p.depo = inDepo - (q - fromShelf);
  saveProducts();
  addLog({ type: 'loss', kind: kind, key: k, name: p.name, qty: q, price: p.price });
  $('lossQty').value = ''; renderGrid(); checkLowBanner(); checkSktBanner();
  showMsg('tl', '✅ ' + q + ' adet ' + p.name + ' ' + kind.toLocaleLowerCase('tr-TR') + ' olarak düşüldü.', 'ok');
}
const SKT_DAYS = 14;
function sktDays(k) {
