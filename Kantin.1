  $('annInfo').textContent = n ? n + ' kişiye gönderilecek (telefonu kayıtlı olanlar).' : 'Gönderilecek kişi yok. Önce telefon numaralı müşteri kaydedin.';
}
function startAnnQueue() {
  const text = $('annText').value.trim();
  if (!text) { showMsg('wm', 'Duyuru metnini yazın.', 'err'); return; }
  settings.tpl = Object.assign({}, settings.tpl, { duyuru: text }); saveSet();
  startQueue('📣 Duyuru', annRecipients().map(k => ({ name: k, phone: customers[k].phone, text: fillTpl(text, baseVars(k)) })));
