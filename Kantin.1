    info.textContent = (age > 0 ? age + ' gündür açık' : 'bugün') + (k && customers[k].lastRem ? ' · son hatırlatma: ' + fmtDate(customers[k].lastRem) : '');
    a.appendChild(nm); a.appendChild(info);
    const c = document.createElement('td'); c.className = 'num'; c.textContent = money(bal(n));
    const d = document.createElement('td'); d.className = 'actions';
    if (ph) d.appendChild(mkBtn('📱 Hatırlat', 'btn-success', () => { markReminded(n); waOpen(waUrl(ph, debtMsg(n))); renderRem(); }));
    else d.appendChild(mkBtn('Telefon ekle', 'btn-gray', () => prefillCustomer(n)));
    tr.appendChild(a); tr.appendChild(c); tr.appendChild(d); b.appendChild(tr);
  });
  $('remInfo').textContent = list.length
    ? withPhone + ' kişiye hatırlatma gönderilebilir' + (noPhone ? ', ' + noPhone + ' kişinin telefonu kayıtlı değil' : '') + '. Toplam alacak: ' + money(tot)
    : 'Bu filtreye uyan açık veresiye yok.';
}
function startDebtQueue() {
  const items = remDebtors().filter(n => phoneOf(n)).map(n => ({ name: n, phone: phoneOf(n), text: debtMsg(n), onSent: () => markReminded(n) }));
  startQueue('📒 Borç hatırlatma', items);
}
function annRecipients() {
  const onlyDebt = $('annAud').value === 'debt';
  return Object.keys(customers).filter(k => customers[k].phone && (!onlyDebt || bal(k) > 0));
}
function updAnnInfo() {
