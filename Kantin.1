// ===================== BULUT / GİRİŞ =====================
function setSyncStatus(s) {
  const box = document.getElementById('acctBox');
  if (!box) return;
  const html = { ok: '<span class="sync-status sync-ok">● Eşitlendi</span>',
                 wait: '<span class="sync-status sync-wait">◐ Eşitleniyor…</span>',
                 err: '<span class="sync-status sync-err">● Eşitleme hatası</span>',
                 off: '<span class="sync-status sync-off">● Bulut kapalı</span>' }[s] || '';
  const cur = box.querySelector('.sync-status');
  if (cur) cur.outerHTML = html;
}
function renderAccount() {
  const box = document.getElementById('acctBox');
  if (!box) return;
  if (!FIREBASE_CONFIG.apiKey) {
    box.innerHTML = '<p class="hint">Bulut kapalı. Veriler yalnızca bu cihazda saklanıyor.</p><span class="sync-status sync-off">● Bulut kapalı</span>';
    return;
  }
  if (!fbUser) {
    box.innerHTML = '<p class="hint">Giriş yapılmadı.</p><span class="sync-status sync-off">● Bulut kapalı</span>';
    return;
  }
  box.innerHTML =
    '<div class="code">' + esc(fbUser.email || '') + '</div>' +
    '<div style="margin-top:6px"><span class="sync-status sync-ok">● Eşitlendi</span></div>' +
    '<p class="hint" style="margin-top:6px">Verileriniz hesabınıza kaydediliyor. Başka bir telefondan aynı e-posta ile giriş yapınca aynı veriler gelir.</p>';
}
async function pushAllToCloud() {
  if (!fbDb || !fbUser) return;
  const data = {};
  for (let i = 0; i < localStorage.length; i++) {
    const k = localStorage.key(i);
    if (k && k.indexOf('kantin_') === 0) data[k] = localStorage.getItem(k);
  }
  if (Object.keys(data).length) {
    await fbDb.collection('users').doc(fbUser.uid).set(data, { merge: true });
  }
}
async function pullAllFromCloud() {
  if (!fbDb || !fbUser) return false;
  const snap = await fbDb.collection('users').doc(fbUser.uid).get();
  const cloud = snap.exists ? (snap.data() || {}) : {};
  const cloudKeys = Object.keys(cloud).filter(k => k.indexOf('kantin_') === 0);
  if (!cloudKeys.length) return false;
  let changed = false;
  cloudKeys.forEach(k => {
    if (localStorage.getItem(k) !== cloud[k]) { _origSetItem(k, cloud[k]); changed = true; }
  });
  const toRemove = [];
  for (let i = 0; i < localStorage.length; i++) {
    const k = localStorage.key(i);
    if (k && k.indexOf('kantin_') === 0 && cloudKeys.indexOf(k) < 0) toRemove.push(k);
  }
  toRemove.forEach(k => { _origRemoveItem(k); changed = true; });
  return changed;
}
async function manualSync() {
  if (!fbUser) { alert('Önce giriş yapın.'); return; }
  setSyncStatus('wait');
  try {
    await pushAllToCloud();
    setSyncStatus('ok');
    showMsg('tl', '✅ Buluta gönderildi.', 'ok');
  } catch (e) {
    setSyncStatus('err');
    showMsg('tl', 'Eşitleme hatası: ' + e.message, 'err');
  }
}
async function doLogout() {
  if (!confirm('Çıkış yapılsın mı? (Veriler cihazda ve hesabınızda kalır.)')) return;
  try { await fbAuth.signOut(); location.reload(); } catch (e) {}
}
function showAuthMode(m) {
  document.getElementById('authLoginView').classList.toggle('hidden', m !== 'login');
  document.getElementById('authRegView').classList.toggle('hidden', m !== 'register');
  document.getElementById('authSub').textContent = m === 'register' ? 'Yeni hesap oluşturun' : 'Hesabınıza giriş yapın';
  const em = document.getElementById(m === 'register' ? 'regEmail' : 'authEmail');
  if (em) setTimeout(() => em.focus(), 100);
}
function authErr(id, t) { const e = document.getElementById(id); e.className = 'msg err'; e.textContent = t; setTimeout(() => { e.className = 'msg'; }, 7000); }
function authOk(id, t) { const e = document.getElementById(id); e.className = 'msg ok'; e.textContent = t; setTimeout(() => { e.className = 'msg'; }, 7000); }
async function doLogin() {
  const email = document.getElementById('authEmail').value.trim();
  const pass = document.getElementById('authPass').value;
  if (!email || !pass) { authErr('authMsg', 'E-posta ve şifre girin.'); return; }
  const b = document.getElementById('authBtn'); b.disabled = true;
  try { await fbAuth.signInWithEmailAndPassword(email, pass); }
  catch (e) { authErr('authMsg', fbErrorTr(e)); }
  b.disabled = false;
}
async function doRegister() {
  const email = document.getElementById('regEmail').value.trim();
  const p1 = document.getElementById('regPass').value;
  const p2 = document.getElementById('regPass2').value;
  if (!email || !p1) { authErr('regMsg', 'E-posta ve şifre girin.'); return; }
  if (p1.length < 6) { authErr('regMsg', 'Şifre en az 6 karakter olmalı.'); return; }
  if (p1 !== p2) { authErr('regMsg', 'Şifreler aynı değil.'); return; }
  const b = document.getElementById('regBtn'); b.disabled = true;
  try { await fbAuth.createUserWithEmailAndPassword(email, p1); }
  catch (e) { authErr('regMsg', fbErrorTr(e)); }
  b.disabled = false;
}
async function doForgot() {
  const email = document.getElementById('authEmail').value.trim();
  if (!email) { authErr('authMsg', 'Önce e-postanızı yazın.'); return; }
  try {
    await fbAuth.sendPasswordResetEmail(email);
    authOk('authMsg', 'Sıfırlama bağlantısı e-postanıza gönderildi.');
  } catch (e) { authErr('authMsg', fbErrorTr(e)); }
}
function fbErrorTr(e) {
  const c = (e && e.code) || '';
  const map = {
    'auth/invalid-email': 'E-posta geçersiz.',
    'auth/user-not-found': 'Bu e-posta ile kayıt yok.',
    'auth/wrong-password': 'Şifre hatalı.',
    'auth/invalid-credential': 'E-posta veya şifre hatalı.',
    'auth/invalid-login-credentials': 'E-posta veya şifre hatalı.',
    'auth/email-already-in-use': 'Bu e-posta zaten kayıtlı.',
    'auth/weak-password': 'Şifre çok zayıf (en az 6 karakter).',
    'auth/network-request-failed': 'İnternet bağlantısı yok.',
    'auth/too-many-requests': 'Çok fazla deneme. Biraz bekleyin.',
    'auth/operation-not-allowed': 'E-posta/şifre girişi Firebase Console\'da etkin değil.'
  };
  return map[c] || (e && e.message) || 'Bir hata oluştu.';
}
function startApp() {
  const aw = document.getElementById('authWrap');
  const mc = document.getElementById('mainContainer');
  if (aw) aw.classList.add('hidden');
  if (mc) mc.classList.remove('hidden');
  const cob = document.getElementById('cloudOffBanner');
  if (cob) cob.classList.toggle('hidden', cloudEnabled || !FIREBASE_CONFIG.apiKey);
  applyDark();
  document.getElementById('modeP1').classList.toggle('active', settings.priceMode === 'p1');
  document.getElementById('modeP2').classList.toggle('active', settings.priceMode === 'p2');
  renderGrid();
  renderCart();
  renderRecent();
  checkLowBanner();
  checkSktBanner();
  checkBkBanner();
  fillDebtNames();
}
function bootAuth() {
  if (!FIREBASE_CONFIG.apiKey) {
    cloudEnabled = false;
    startApp();
    return;
  }
  try {
    firebase.initializeApp(FIREBASE_CONFIG);
    fbAuth = firebase.auth();
    fbDb = firebase.firestore();
  } catch (e) {
    console.error(e);
    alert('Firebase başlatılamadı: ' + e.message);
    cloudEnabled = false;
    startApp();
    return;
  }
  fbAuth.onAuthStateChanged(async (user) => {
    if (!user) {
      fbUser = null; cloudEnabled = false;
      document.getElementById('mainContainer').classList.add('hidden');
      document.getElementById('authWrap').classList.remove('hidden');
      showAuthMode('login');
      return;
    }
    fbUser = user;
    try {
      const changed = await pullAllFromCloud();
      if (changed) { location.reload(); return; }
      cloudEnabled = true;
      startApp();
    } catch (e) {
      console.error(e);
      alert('Bulut verisine ulaşılamadı: ' + e.message + '\nUygulama yerel verilerle açılıyor.');
      cloudEnabled = false;
      startApp();
    }
  });
}

// ===== Başlangıç =====
bootAuth();
</script>
